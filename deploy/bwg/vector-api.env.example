# Install as /etc/poetry/vector-api.env, owned by root with mode 0600.
# Add QDRANT_CLUSTER_ENDPOINT, QDRANT_API_KEY, and SILICONFLOW_API_KEY privately.
# QDRANT_URL must be absent so the Cloud endpoint takes precedence over local defaults.
HTTP_ADDR=127.0.0.1:18080
HTTP_CONCURRENCY=64
SEARCH_REQUESTS_PER_SECOND=2
SEARCH_BURST=4
DETAIL_REQUESTS_PER_SECOND=10
DETAIL_BURST=20
DETAIL_CONCURRENCY=8
DETAIL_CACHE_BYTES=8388608
DETAIL_CACHE_TTL=3600
EMBEDDING_REQUESTS_PER_MINUTE=120
SQLITE_DB_PATH=/opt/poetry-tang/corpus/chinese_poetry.db
DATASETS_CONFIG_PATH=/opt/poetry-tang/corpus/datas.json
QDRANT_TLS=true
COLLECTION_NAME=poetry_tang_20260922_v1
CORPUS_GENERATION=poetry-20260921-v1
VECTOR_DIM=1024
EMBEDDING_PROFILE=sf-bge-m3-1024-v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT=5
SEARCH_CONCURRENCY=16
QDRANT_HNSW_EF=64
RERANK_ENABLED=false
RESPONSE_CACHE_BYTES=8388608
VECTOR_CACHE_BYTES=8388608
RESPONSE_CACHE_TTL=3600
GOMEMLIMIT=160MiB
